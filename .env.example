# Copy to .env and replace placeholders. Never commit .env.
# Use Npgsql key=value syntax, not a postgresql:// URL.
ConnectionStrings__AirQuality='Host=YOUR_NEON_HOST;Port=5432;Database=neondb;Username=YOUR_USER;Password=YOUR_PASSWORD;SSL Mode=Require;Channel Binding=Require'

# Replace the secret in each variable NAME, preserving the reader/admin value.
ApiKeys__replace_with_your_reader_secret=reader
ApiKeys__replace_with_your_admin_secret=admin

# Optional local Docker port (http://localhost:5251).
API_PORT=5251
